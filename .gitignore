# 工作区级缓存与临时文件（Go/Flutter 构建缓存、冒烟测试数据）
/.cache/
/.tmp/
/screenshots/

# 审计/外部交付物（不入仓）
/sjbg.docx
/audit*.docx
/reports/

# 冒烟测试/临时跑批数据目录（CI/手工 smoke run）
/server/.tmp_*/
/server/.tmp/

# 真机调试临时产物（cookie/响应缓存/探测脚本，含敏感信息不入库）
/.codelf/cookies.txt
/.codelf/tmp_h.json
/.codelf/ws_probe.ps1
/.codelf/*.probe

# Go 构建产物（cmd/xmedia → ./bin/xmedia.exe）
/server/bin/
/server/out/

# Hermes 审计单测（带 hermesreset/hermesverify build tag，ad-hoc 验证用，不入库）
server/internal/**/hermes_*.go

# 临时搬迁的二进制（防 antivirus lock 残留）
/server/.bin_old/

# Flutter 桌面构建产物：详见 client/.gitignore（Flutter 模板已含 build/.dart_tool/.pub/.pub-cache 等）

# 系统
.DS_Store
Thumbs.db
*.log

# Hermes ad-hoc 验证临时产物（不进入仓库，下一次跑会重新生成）
/hc5-*.exe
/hc5-*.db
/hc5-*.db-shm
/hc5-*.db-wal
/srv*.err
/srv*.out
